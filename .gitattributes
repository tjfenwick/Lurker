* text=auto eol=lf

# Treat as text and use LF on checkout for cross-platform consistency
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.css text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.webmanifest text eol=lf

# Don't normalize binaries
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
